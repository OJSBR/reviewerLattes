#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.scope.all"
msgstr "Wszyscy recenzenci, z dowolnego kraju"

#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.student"
msgstr "Studenci"

#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.student.description"
msgstr "Niektóre czasopisma przyjmują tylko recenzentów z ukończonymi studiami. Wpisz jeden fragment adresu e-mail w każdym wierszu — na przykład @student. — a adres zawierający którykolwiek z nich nie będzie mógł zgłosić się jako recenzent. Wielkość liter nie ma znaczenia. Pozostaw puste, aby dopuścić wszystkich."

#, fuzzy
