#, fuzzy
msgid "plugins.generic.reviewerLattes.displayName"
msgstr "Lattes dla recenzentów"

#, fuzzy
msgid "plugins.generic.reviewerLattes.description"
msgstr "Prosi osoby zgłaszające się jako recenzenci — w formularzu rejestracji lub w rolach swojego profilu — o link do ich CV w Lattes (CNPq, Brazylia), zapisywany jako adres URL konta. Każde czasopismo decyduje, od kogo jest wymagany, i może nie dopuszczać studentów jako recenzentów."

#, fuzzy
