#, fuzzy
msgid "plugins.generic.reviewerLattes.displayName"
msgstr "لاتس برای داوران"

#, fuzzy
msgid "plugins.generic.reviewerLattes.description"
msgstr "از کسانی که به‌عنوان داور ثبت‌نام می‌کنند — در فرم ثبت‌نام یا در نقش‌های نمایهٔ خود — پیوند رزومهٔ لاتس آنها (CNPq، برزیل) را می‌خواهد و آن را به‌عنوان URL حساب ذخیره می‌کند. هر مجله تعیین می‌کند ارائهٔ آن برای چه کسانی الزامی است و می‌تواند مانع ثبت‌نام دانشجویان به‌عنوان داور شود."

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.label"
msgstr "رزومهٔ لاتس (پیوند)"

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.example"
msgstr "https://lattes.cnpq.br/1234567890123456"

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.description"
msgstr "نشانی رزومهٔ لاتس شما در CNPq، برای نمونه {$example}."

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.requiredForBrazil"
msgstr "برای داوران برزیل الزامی است."

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.requiredForAll"
msgstr "برای داوران الزامی است."

#, fuzzy
