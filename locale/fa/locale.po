msgstr "نشانی‌های رایانامهٔ دانشجویان"

#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.student.invalid"
msgstr "حداکثر ۵۰ بخش وارد کنید، هر خط یکی، هر کدام حداکثر ۱۰۰ نویسه."

#, fuzzy
msgid "plugins.generic.reviewerLattes.student.error"
msgstr "این مجله دانشجویان را به‌عنوان داور نمی‌پذیرد: حسابی با رایانامهٔ دانشجویی نمی‌تواند برای داوری ثبت‌نام کند."

#, fuzzy
msgid "plugins.generic.reviewerLattes.student.notice"
msgstr "این مجله دانشجویان را به‌عنوان داور نمی‌پذیرد، بنابراین این رایانامه نمی‌تواند برای داوری ثبت‌نام کند."
