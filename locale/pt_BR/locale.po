msgid "plugins.generic.reviewerLattes.displayName"
msgstr "Lattes do Avaliador"

msgid "plugins.generic.reviewerLattes.description"
msgstr "Pede a quem se inscreve como avaliador — no formulário de cadastro ou nos papéis do perfil — o link do Currículo Lattes (CNPq), gravado como URL da conta. Cada revista decide de quem o link é obrigatório e pode impedir estudantes de se inscreverem como avaliadores."

msgid "plugins.generic.reviewerLattes.field.label"
msgstr "Currículo Lattes (link)"

msgid "plugins.generic.reviewerLattes.field.example"
msgstr "https://lattes.cnpq.br/1234567890123456"

msgid "plugins.generic.reviewerLattes.field.description"
msgstr "O endereço do seu Currículo Lattes no CNPq, por exemplo {$example}."

msgid "plugins.generic.reviewerLattes.field.requiredForBrazil"
msgstr "Obrigatório para avaliadores do Brasil."

msgid "plugins.generic.reviewerLattes.field.requiredForAll"
msgstr "Obrigatório para avaliadores."

msgid "plugins.generic.reviewerLattes.field.invalid"
msgstr "Informe o endereço de um Currículo Lattes: lattes.cnpq.br/ seguido dos 16 dígitos do seu ID Lattes."

msgid "plugins.generic.reviewerLattes.field.required"
msgstr "O link do Currículo Lattes é obrigatório para avaliadores do Brasil."

msgid "plugins.generic.reviewerLattes.field.requiredAll"
msgstr "O link do Currículo Lattes é obrigatório para avaliadores."

msgid "plugins.generic.reviewerLattes.settings.intro"
msgstr "Quando alguém se inscreve para avaliar nesta revista — no formulário de cadastro ou marcando o papel de avaliador no perfil — é pedido o link do Currículo Lattes, que precisa ser um endereço do Lattes. O link é gravado como URL da conta; um link do Lattes que já esteja lá nunca é substituído."

msgid "plugins.generic.reviewerLattes.settings.scope"
msgstr "Quem precisa informar o link do Lattes"

msgid "plugins.generic.reviewerLattes.settings.scope.description"
msgstr "Vale para quem se inscreve como avaliador. O que for digitado no campo sempre precisa ser um endereço válido do Lattes."

msgid "plugins.generic.reviewerLattes.settings.scope.none"
msgstr "Ninguém: o link é sempre opcional"

msgid "plugins.generic.reviewerLattes.settings.scope.brazil"
msgstr "Avaliadores do Brasil (opcional para outros países)"

msgid "plugins.generic.reviewerLattes.settings.scope.all"
msgstr "Todos os avaliadores, de qualquer país"

msgid "plugins.generic.reviewerLattes.settings.student"
msgstr "Estudantes"

msgid "plugins.generic.reviewerLattes.settings.student.description"
msgstr "Algumas revistas aceitam apenas avaliadores com graduação concluída. Informe um trecho de endereço de e-mail por linha — por exemplo @aluno. — e um endereço que contenha qualquer um deles não poderá se inscrever como avaliador. Maiúsculas e minúsculas não fazem diferença. Deixe vazio para permitir todos."

msgid "plugins.generic.reviewerLattes.settings.studentEmailPatterns"
msgstr "E-mails de estudantes"

msgid "plugins.generic.reviewerLattes.settings.student.invalid"
msgstr "Informe até 50 trechos, um por linha, cada um com no máximo 100 caracteres."

msgid "plugins.generic.reviewerLattes.student.error"
msgstr "Esta revista não aceita estudantes como avaliadores: uma conta com e-mail de estudante não pode se inscrever para avaliar."

msgid "plugins.generic.reviewerLattes.student.notice"
msgstr "Esta revista não aceita estudantes como avaliadores, por isso este e-mail não pode se inscrever para avaliar."
