#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.intro"
msgstr "Kimsə bu jurnalda rəy vermək üçün qeydiyyatdan keçəndə — qeydiyyat formasında və ya profildə rəyçi rolunu işarələyəndə — ondan Lattes CV linki istənilir və bu, Lattes ünvanı olmalıdır. Link hesabın URL-i kimi saxlanılır; artıq mövcud olan Lattes linki heç vaxt əvəz edilmir."

#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.scope"
msgstr "Lattes linkini kim göstərməlidir"

#, fuzzy
