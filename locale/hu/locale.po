msgstr "Kötelező a brazíliai bírálóknak."

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.requiredForAll"
msgstr "Kötelező a bírálóknak."

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.invalid"
msgstr "Adja meg egy Lattes-önéletrajz címét: lattes.cnpq.br/, majd Lattes-azonosítójának 16 számjegye."

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.required"
msgstr "A Lattes-önéletrajz linkje kötelező a brazíliai bírálóknak."

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.requiredAll"
