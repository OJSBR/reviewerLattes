#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.intro"
msgstr "Amikor valaki bírálónak jelentkezik ennél a folyóiratnál — a regisztrációs űrlapon vagy a bírálói szerep bejelölésével a profiljában —, elkérik tőle a Lattes-önéletrajza linkjét, amelynek Lattes-címnek kell lennie. A link a fiók URL-jeként mentődik; a már meglévő Lattes-linket sosem cseréli le."

#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.scope"
msgstr "Kinek kell megadnia a Lattes-linket"

#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.scope.description"
msgstr "Arra vonatkozik, aki bírálónak jelentkezik. A mezőbe írt értéknek mindig érvényes Lattes-címnek kell lennie."

#, fuzzy
msgid "plugins.generic.reviewerLattes.settings.scope.none"
msgstr "Senkinek: a link mindig nem kötelező"

#, fuzzy
