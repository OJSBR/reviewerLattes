#, fuzzy
msgid "plugins.generic.reviewerLattes.displayName"
msgstr "Lattes bírálóknak"

#, fuzzy
msgid "plugins.generic.reviewerLattes.description"
msgstr "A bírálónak jelentkezőktől — a regisztrációs űrlapon vagy a profiljuk szerepeinél — elkéri a Lattes-önéletrajzuk (CNPq, Brazília) linkjét, és a fiók URL-jeként menti. Minden folyóirat eldönti, kitől kötelező, és megakadályozhatja, hogy hallgatók bírálónak jelentkezzenek."

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.label"
msgstr "Lattes-önéletrajz (link)"

#, fuzzy
msgid "plugins.generic.reviewerLattes.field.example"
msgstr "https://lattes.cnpq.br/1234567890123456"

#, fuzzy
