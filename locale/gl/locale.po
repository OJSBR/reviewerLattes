msgid "plugins.generic.reviewerLattes.displayName"
msgstr "Lattes do Revisor"

msgid "plugins.generic.reviewerLattes.description"
msgstr "Pide a quen se rexistra como revisor a ligazón ao seu Currículo Lattes (CNPq, Brasil), gardada como URL da conta. Cada revista pode esixila aos revisores do Brasil."

msgid "plugins.generic.reviewerLattes.field.label"
msgstr "Currículo Lattes (ligazón)"

msgid "plugins.generic.reviewerLattes.field.example"
msgstr "https://lattes.cnpq.br/1234567890123456"

msgid "plugins.generic.reviewerLattes.field.description"
msgstr "O enderezo do seu Currículo Lattes no CNPq, por exemplo {$example}."

msgid "plugins.generic.reviewerLattes.field.requiredForBrazil"
msgstr "Obrigatorio para revisores do Brasil."

msgid "plugins.generic.reviewerLattes.field.invalid"
msgstr "Introduza o enderezo dun Currículo Lattes: lattes.cnpq.br/ seguido dos 16 díxitos do seu ID Lattes."

msgid "plugins.generic.reviewerLattes.field.required"
msgstr "A ligazón ao Currículo Lattes é obrigatoria para revisores do Brasil."

msgid "plugins.generic.reviewerLattes.settings.intro"
msgstr "Cando alguén se rexistra e pide revisar para esta revista, o formulario de rexistro pide a ligazón ao seu Currículo Lattes e comproba que sexa un enderezo do Lattes. A ligazón gárdase como URL da conta."

msgid "plugins.generic.reviewerLattes.settings.brazil"
msgstr "Revisores do Brasil"

msgid "plugins.generic.reviewerLattes.settings.brazil.description"
msgstr "Aplícase a quen escolle Brasil como país e marca a opción de revisor."

msgid "plugins.generic.reviewerLattes.settings.optional"
msgstr "A ligazón ao Lattes é opcional"

msgid "plugins.generic.reviewerLattes.settings.required"
msgstr "A ligazón ao Lattes é obrigatoria (marcada como obrigatoria no formulario)"

msgid "plugins.generic.reviewerLattes.settings.otherCountries"
msgstr "Os revisores doutros países tamén poden indicar a súa ligazón ao Lattes, pero nunca se lles esixe."
